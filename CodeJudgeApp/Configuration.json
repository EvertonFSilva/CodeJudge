{
  "ai": {
    "default": "ollama",
    "isUserKeyRequired": false,
    "adapters": {
      "GeminiAdapter": "Infrastructure.Engines.GeminiAdapter.GeminiAdapter",
      "OllamaAdapter": "Infrastructure.Engines.OllamaAdapter.OllamaAdapter"
    },
    "engines": {
      "gemini": {
        "name": "Google Gemini",
        "adapter": "GeminiAdapter",
        "requiresApiKey": true,
        "supportedModels": [
          "gemini-3.1-pro-preview",
          "gemini-3.1-flash-preview",
          "gemini-3.1-flash-lite-preview",
          "gemini-3-pro-preview",
          "gemini-3-flash-preview",
          "gemini-2.5-pro",
          "gemini-2.5-pro-preview",
          "gemini-2.5-flash",
          "gemini-2.5-flash-preview",
          "gemini-2.5-flash-lite",
          "gemini-2.5-flash-lite-preview",
          "gemini-2.0-flash",
          "gemini-2.0-flash-001",
          "gemini-2.0-flash-lite",
          "gemini-2.0-flash-lite-001",
          "gemini-2.0-flash-thinking-exp",
          "gemini-2.0-pro-exp",
          "gemini-1.5-pro",
          "gemini-1.5-pro-latest",
          "gemini-1.5-flash",
          "gemini-1.5-flash-latest",
          "gemini-1.5-flash-8b"
        ],
        "args": {
          "apiKey": "AIzaSyA09MlWiUecQtuXR0n6scO0ef2mwxbwYxc",
          "model": "gemini-2.5-flash"
        }
      },
      "ollama": {
        "name": "Ollama (Local)",
        "adapter": "OllamaAdapter",
        "requiresApiKey": false,
        "supportedModels": [
          "llama3:latest",
          "llama3.1:latest",
          "llama3.2:latest",
          "llama3.3:latest",
          "llama4:latest",
          "qwen2.5-coder:latest",
          "qwen2.5-coder:7b",
          "qwen2.5-coder:14b",
          "qwen2.5-coder:32b",
          "qwen2.5:latest",
          "qwen3:latest",
          "qwen3-coder:latest",
          "deepseek-coder:latest",
          "deepseek-coder-v2:latest",
          "deepseek-r1:latest",
          "deepseek-r1:7b",
          "deepseek-r1:14b",
          "deepseek-r1:32b",
          "deepseek-v3:latest",
          "codellama:latest",
          "codestral:latest",
          "gemma2:latest",
          "gemma3:latest",
          "mistral:latest",
          "phi3:latest",
          "phi4:latest",
          "starcoder2:latest"
        ],
        "args": {
          "endpoint": "http://localhost:11434/v1",
          "model": "llama3:latest",
          "apiKey": "ollama",
          "timeoutSeconds": 300
        }
      }
    }
  },
  "languages": {
    "c": {
      "name": "C",
      "sourceExtension": ".c",
      "targetExtension": ".exe",
      "entryNamingStrategy": "fixed",
      "compiler": {
        "command": "gcc",
        "arguments": ["{source}", "-o", "{target}", "-O2", "-Wall"]
      },
      "executor": {
        "command": "{target}",
        "arguments": []
      }
    },
    "cpp": {
      "name": "C++",
      "sourceExtension": ".cpp",
      "targetExtension": ".exe",
      "entryNamingStrategy": "fixed",
      "compiler": {
        "command": "g++",
        "arguments": ["{source}", "-o", "{target}", "-O2", "-Wall"]
      },
      "executor": {
        "command": "{target}",
        "arguments": []
      }
    },
    "java": {
      "name": "Java",
      "sourceExtension": ".java",
      "targetExtension": ".class",
      "entryNamingStrategy": "className",
      "compiler": {
        "command": "javac",
        "arguments": ["-encoding", "UTF-8", "{source}"]
      },
      "executor": {
        "command": "java",
        "arguments": ["-cp", "{workspace}", "{entryClass}"]
      }
    },
    "python": {
      "name": "Python",
      "sourceExtension": ".py",
      "targetExtension": "",
      "entryNamingStrategy": "fixed",
      "compiler": {
        "command": "",
        "arguments": []
      },
      "executor": {
        "command": "python",
        "arguments": ["{source}"]
      }
    }
  },
  "execution": {
    "timeoutSeconds": 10
  },
  "templates": {
    "directory": "./Infrastructure/Templates"
  }
}
